# Copie para .env e preencha com valores unicos e fortes.
# Nunca versione .env, certificados, chaves ou credenciais de provedores.

# ---- Banco PostgreSQL em nuvem (Neon / Supabase / Azure Database for PostgreSQL) ----
# Neon:     jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
# Supabase: use o "Session pooler" (host do pooler, porta 5432)
# Azure:    jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/<db>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Usados apenas pelo docker-compose local (Postgres em container)
DB_NAME=imperiodog

# ---- JWT ----
# Gere com: openssl rand -base64 48   (minimo 32 bytes). Sem JWT_SECRET, o profile local usa um valor de dev.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ---- CORS: origens do frontend, separadas por virgula ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
# Opcional (previews da Vercel): https://seu-projeto-*.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=

# ---- Primeiro administrador (criado so se ainda nao existir nenhum ADMIN) ----
# Senha com no minimo 12 caracteres. Remova estas variaveis depois do primeiro boot.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Producao ----
# SPRING_PROFILES_ACTIVE=prod

# ---- C6 Bank ----
C6_API_BASE_URL=https://baas-api-sandbox.c6bank.info
C6_CLIENT_ID=
C6_CLIENT_SECRET=
C6_CERTIFICATE_FILE=./secrets/c6-client.p12
C6_CERTIFICATE_PATH=./secrets/c6-client.p12
C6_CERTIFICATE_PASSWORD=
C6_BILLING_SCHEME=21
C6_WEBHOOK_URL=
C6_WEBHOOK_TOKEN=
C6_STATUS_SYNC_INTERVAL_MS=300000
