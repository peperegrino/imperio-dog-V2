# Copy to .env and set unique, strong values before starting the application.
# Never commit .env, certificates, keys, or provider credentials.
DB_NAME=imperiodog
DB_USERNAME=imperio_dog_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/imperiodog?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Generate a new random value with at least 32 bytes. Do not reuse a production secret.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

C6_API_BASE_URL=https://baas-api-sandbox.c6bank.info
C6_CLIENT_ID=
C6_CLIENT_SECRET=
C6_CERTIFICATE_FILE=./secrets/c6-client.p12
C6_CERTIFICATE_PATH=./secrets/c6-client.p12
C6_CERTIFICATE_PASSWORD=
C6_BILLING_SCHEME=21
C6_WEBHOOK_URL=
C6_WEBHOOK_TOKEN=
C6_STATUS_SYNC_INTERVAL_MS=300000
